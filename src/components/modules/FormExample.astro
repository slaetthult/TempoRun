---
import Selectbox from "@components/partials/Selectbox.astro";
import TheForm from "@components/partials/TheForm.astro";
import TheCheckbox from "@components/partials/TheCheckbox.astro";
import TheInput from "@components/partials/TheInput.astro";
import TheTextarea from "@components/partials/TheTextarea.astro";
import TheRadiobox from "@components/partials/TheRadiobox.astro";
import TheButton from "@components/partials/TheButton.astro";

if (Astro.request.method === "POST") {
    try {
        console.error("form sent");
    } catch (error) {
        if (error instanceof Error) {
            console.error("form not sent");
        }
    }
}
---
<module-form-example class="form-example" data-js="form-example">
    <div class="grid-wrap">
        <div class="w12">

            <h2>Form example</h2>

            <TheForm method="POST" id="form-example" validation={true} validationSubmitMessage="Form submitted!">

                <Selectbox name="person" maxSelectable="2" dataValidationRequired classes="w12">
                    <option value="">Select a person...</option>
                    <option value="4">Thomas Edison</option>
                    <option value="1">Nikola</option>
                    <option value="3">Nikola Tesla</option>
                    <option value="5">Arnold Schwarzenegger</option>
                </Selectbox>
                <TheRadiobox
                        className="w6"
                        name="gender"
                        text="Mr."
                        value="1"
                        required={true}
                        errorText="Required"
                />
                <TheRadiobox
                        className="w6"
                        name="gender"
                        text="Mrs."
                        value="1"
                        required={true}
                />
                <TheInput
                        type="text"
                        name="firstName"
                        className="w6"
                        labelText="First name:"
                        value=""
                        required={true}
                        errorText="Required"
                        minlength="4"
                />
                <TheInput
                        type="text"
                        name="lastName"
                        className="w6"
                        labelText="Last name:"
                        value=""
                        required={true}
                        errorText="Required"
                        minlength="4"
                />
                <TheInput
                        type="email"
                        name="email"
                        className="w12"
                        labelText="E-mail:"
                        value=""
                        required={true}
                        errorText="Required"
                />
                <TheInput
                        type="tel"
                        name="tel"
                        className="w12"
                        labelText="Phone:"
                        value=""
                        required={true}
                        errorText="Required"
                />
                <TheInput
                        type="password"
                        name="password"
                        className="w12"
                        labelText="Password:"
                        value=""
                        required={true}
                        errorText="Must contain at least 8 or more characters"
                        minlength="8"

                />
                <TheInput
                        type="password"
                        name="passwordConfirm"
                        className="w12"
                        labelText="Confirm password:"
                        value=""
                        required={true}
                        errorText=""
                        minlength="8"
                />
                <TheTextarea
                        name="message"
                        className="w12"
                        labelText="Message:"
                        value=""
                        errorText="Please type in at least 4 and maximum 10 letters"
                        minlength="4"
                        maxlength="10"
                />
                <TheCheckbox
                        className="w12"
                        name="tos"
                        value="1"
                        text="I accept"
                        required={true}
                        errorText="Required"
                />
                <TheButton type="submit">Submit</TheButton>
            </TheForm>

        </div>
    </div>
</module-form-example>


<script>
    class ModuleFormExample extends HTMLElement {
        constructor() {
            super();
        }
        connectedCallback() {
            import('@scripts/modules/form-example')
                .then((module) => {
                    const { formExample } = module;
                    formExample.init(this);
                })
                .catch((error) => {
                    console.error('Error loading module:', error);
                });
        }

    }
    customElements.define('module-form-example', ModuleFormExample);
</script>