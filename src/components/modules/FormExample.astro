---
import Selectbox from '@components/partials/Selectbox.astro';
import Radiobox from '@components/partials/Radiobox.astro';
import Input from '@components/partials/Input.astro';
import Textarea from '@components/partials/Textarea.astro';
import Checkbox from '@components/partials/Checkbox.astro';
import Button from '@components/partials/Button.astro';
import '@styles/modules/_form-example.scss';

if (Astro.request.method === 'POST') {
    try {
        console.error('form sent');
    } catch (error) {
        if (error instanceof Error) {
            console.error('form not sent');
        }
    }
}
---

<div class="form-example">
    <div class="grid-wrap">
        <div class="w12">

            <h2>Form example</h2>

            <form method="POST" id="form-example" class="form" data-js="form-validation" data-validation-submit-message="Form submitted!">

                <Selectbox maxSelectable="1" dataValidationRequired classes="w12">
                    <option value="">Select a person...</option>
                    <option value="4">Thomas Edison</option>
                    <option value="1">Nikola</option>
                    <option value="3">Nikola Tesla</option>
                    <option value="5">Arnold Schwarzenegger</option>
                </Selectbox>

                <Radiobox
                        className="w6"
                        name="gender"
                        text="Mr."
                        value="1"
                        required={true}
                        errorText="Required"
                />
                <Radiobox
                        className="w6"
                        name="gender"
                        text="Mrs."
                        value="1"
                        required={true}
                />
                <Input
                        type="text"
                        name="firstName"
                        className="w6"
                        labelText="First name:"
                        value=""
                        required={true}
                        errorText="Required"
                        minlength="4"
                />
                <Input
                        type="text"
                        name="lastName"
                        className="w6"
                        labelText="Last name:"
                        value=""
                        required={true}
                        errorText="Required"
                        minlength="4"
                />
                <Input
                        type="email"
                        name="email"
                        className="w12"
                        labelText="E-mail:"
                        value=""
                        required={true}
                        errorText="Required"
                />
                <Input
                        type="tel"
                        name="tel"
                        className="w12"
                        labelText="Phone:"
                        value=""
                        required={true}
                        errorText="Required"
                />
                <Input
                        type="password"
                        name="password"
                        className="w12"
                        labelText="Password:"
                        value=""
                        required={true}
                        errorText="Must contain at least 8 or more characters"
                        minlength="8"

                />
                <Input
                        type="password"
                        name="passwordConfirm"
                        className="w12"
                        labelText="Confirm password:"
                        value=""
                        required={true}
                        errorText=""
                        minlength="8"
                />
                <Textarea
                        name="message"
                        className="w12"
                        labelText="Message:"
                        value=""
                        errorText="Please type in at least 4 and maximum 10 letters"
                        minlength="4"
                        maxlength="10"
                />
                <Checkbox
                        className="w12"
                        name="tos"
                        value="1"
                        text="I accept"
                        required={true}
                        errorText="Required"
                />
                <Button type="submit">Submit</Button>
            </form>

        </div>
    </div>
</div>

<script>
    import {formExample} from "@scripts/modules/form-example";

    formExample.init();
</script>