---
import Accordion from '@components/partials/Accordion.astro';
import AccordionGroup from '@components/partials/AccordionGroup.astro';
import Image from '@components/partials/Image.astro';
import '@styles/modules/_content-accordion.scss';

const accordionSettings = {
    duration:                               400,
    showMultiple:                           false,
    openOnInit:                             [0],
    disableAdditionalGeneralOptions:        false
