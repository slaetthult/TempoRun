---
import 'tom-select/dist/css/tom-select.css';
interface Props {
    maxSelectable: number;
    classes: string;
    dataValidationRequired: boolean;
    redirectToValue: boolean;
}

const { maxSelectable = 1, name = '', classes = '', dataValidationRequired = false, redirectToValue = false } = Astro.props;

const classNames = `selectbox ${classes}`;
---

<partial-selectbox class={classNames} data-js="selectbox" data-select-max-selectable={maxSelectable} data-redirect-to-value={redirectToValue}>
    <label>
        {dataValidationRequired ?
                <select name={name} data-validation-required autocomplete="off">
                    <slot />
                </select>
                <small class="validation-error-message">Required</small>
        :
                <select name={name} autocomplete="off">
                    <slot />
                </select>
        }
    </label>
</partial-selectbox>

<script>
    class PartialSelectbox extends HTMLElement {
        constructor() {
            super();
        }
        connectedCallback() {
            import('@scripts/partials/selectbox')
                .then((module) => {
                    const { selectbox } = module;
                    selectbox.init(this);
                })
                .catch((error) => {
                    console.error('Error loading module:', error);
                });

        }

    }
    customElements.define('partial-selectbox', PartialSelectbox);
</script>