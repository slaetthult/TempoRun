---
import 'tom-select/dist/css/tom-select.css';
import '@styles/partials/_selectbox.scss';

const {
    maxSelectable = 1,
    name = '',
    classes = '',
    dataValidationRequired = false,
    redirectToValue = false
} = Astro.props;

const classNames = `selectbox ${classes}`;
---

<div class={classNames} data-js="selectbox" data-select-max-selectable={maxSelectable} data-redirect-to-value={redirectToValue}>
    <label>
        {dataValidationRequired ?
                <select name={name} data-validation-required autocomplete="off">
                    <slot />
                </select>
                <small class="validation-error-message">Required</small>
        :
                <select name={name} autocomplete="off">
                    <slot />
                </select>
        }
    </label>
</div>

<script>
    const $selectboxes = document.querySelectorAll('*[data-js=selectbox]');

    if($selectboxes.length > 0){
        import('@scripts/partials/selectbox')
            .then((module) => {
                const { selectbox } = module;

                selectbox.init();
            })
            .catch((error) => {
                console.error('Error loading module:', error);
            });
    }
</script>