---
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';
import 'swiper/css/scrollbar';

const {sliderSettings = ''} = Astro.props;
---
<partial-slider class="swiper" data-js="slider" data-slider-settings={sliderSettings}>

    <div class="swiper-wrapper">

        <slot />

    </div>

    <div class="swiper-pagination"></div>

    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>

    <div class="swiper-scrollbar"></div>

</partial-slider>

<script>
    class PartialSlider extends HTMLElement {
        constructor() {
            super();
        }
        connectedCallback() {
            import('@scripts/partials/slider')
                .then((module) => {
                    const { slider } = module;
                    slider.init(this);
                })
                .catch((error) => {
                    console.error('Error loading module:', error);
                });
        }

    }
    customElements.define('partial-slider', PartialSlider);
</script>