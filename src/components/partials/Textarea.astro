---
const {
    name = '',
    value = '',
    labelText = '',
    required = false,
    errorText = '',
    className = '',
    minlength = '',
    maxlength = '',
    movingPlaceholder = false
} = Astro.props;

let requiredAttribute = required ? 'data-validation-required' : '';
let minlengthAttribute = minlength ? `minlength="${minlength}"` : '';
let maxlengthAttribute = maxlength ? `maxlength="${maxlength}"` : '';

const textareaHTML = `<textarea data-value="${value}" ${requiredAttribute} ${minlengthAttribute} ${maxlengthAttribute}>${value}</textarea>`;
---
<div class=`textarea ${className}`>
    <label>
        {!movingPlaceholder &&
            <Fragment>
                {labelText}
            </Fragment>
        }
        <Fragment set:html={textareaHTML}/>
        {movingPlaceholder &&
            <span>{labelText}</span>
        }
        {errorText &&
            <small>{errorText}</small>
        }
    </label>
</div>