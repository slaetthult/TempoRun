---
const {accordionSettings = ''} = Astro.props;
---
<partial-accordion-group class="accordion-group accordion-container" data-js="accordion-group" data-accordion-settings={accordionSettings}>
    <slot />
</partial-accordion-group>


<script>
    class PartialAccordionGroup extends HTMLElement {
        constructor() {
            super();
        }
        connectedCallback() {
            import('@scripts/partials/accordion-group')
                .then((module) => {
                    const { accordionGroup } = module;
                    accordionGroup.init(this);
                })
                .catch((error) => {
                    console.error('Error loading module:', error);
                });

        }

    }
    customElements.define('partial-accordion-group', PartialAccordionGroup);
</script>