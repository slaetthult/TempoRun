---
const {
    accordionSettings = ''
} = Astro.props;
---

<div class="accordion-group accordion-container" data-js="accordion-group" data-accordion-settings={accordionSettings}>

    <slot />

</div>

<script>
    const $accordionGroups = document.querySelectorAll('*[data-js=accordion-group]');

    if($accordionGroups.length > 0){
        import('@scripts/partials/accordion-group')
            .then((module) => {
                const { accordionGroup } = module;

                accordionGroup.init();
            })
            .catch((error) => {
                console.error('Error loading module:', error);
            });
    }
</script>