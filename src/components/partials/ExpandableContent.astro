---
import '@styles/partials/_expandable-content.scss';
const {
    forceIntoParagraph = false,
    textMore = 'Weiterlesen',
    textLess = 'Weniger',
    scrollAfterCollapse = 'true',
    classes = ''
} = Astro.props;
---
<div class=`expandable-content ${classes}` data-js="expandable-content" data-expandable-content-scroll-after-collapse={scrollAfterCollapse}>
    <div class="expandable-content__wrapper" data-expandable-content-wrapper>
        {forceIntoParagraph ?
            <p>
                <slot/>
            </p>
            :
            <slot/>
        }
    </div>
    <div class="expandable-content__actions">
        <button data-expandable-content-toggle>
            <span>{textMore}</span>
            <span>{textLess}</span>
        </button>
    </div>
</div>

<script>
    import {scriptLoader} from "@scripts/base/script-loader";
    scriptLoader('*[data-js=expandable-content]', 'scripts/partials/expandable-content');
</script>