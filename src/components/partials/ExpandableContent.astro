---
const { forceIntoParagraph = false, textMore = 'Weiterlesen', textLess = 'Weniger', scrollAfterCollapse = 'true', classes = '' } = Astro.props;
---
<partial-expandable-content class=`expandable-content ${classes}` data-js="expandable-content" data-expandable-content-scroll-after-collapse={scrollAfterCollapse}>
    <div class="expandable-content__wrapper" data-expandable-content-wrapper>
        {forceIntoParagraph ?
            <p>
                <slot/>
            </p>
            :
            <slot/>
        }
    </div>
    <div class="expandable-content__actions">
        <button data-expandable-content-toggle>
            <span>{textMore}</span>
            <span>{textLess}</span>
        </button>
    </div>
</partial-expandable-content>

<script>
    class PartialExpandableContent extends HTMLElement {
        constructor() {
            super();
        }
        connectedCallback() {
            import('@scripts/partials/expandable-content')
                .then((module) => {
                    const { expandableContent } = module;
                    expandableContent.init(this);
                })
                .catch((error) => {
                    console.error('Error loading module:', error);
                });

        }

    }
    customElements.define('partial-expandable-content', PartialExpandableContent);
</script>