---
import '@styles/partials/_google-map.scss';
const {
    geoLocation,
    markerHTML,
    zoom = 8
} = Astro.props;
---

<div class="google-map" data-js="google-map" data-google-zoom-factor={JSON.stringify(zoom)} data-google-map-geo-location={JSON.stringify(geoLocation)} data-google-marker-html={JSON.stringify(markerHTML)} style="display: none;"></div>

<script>
    import {scriptLoader} from "@scripts/base/script-loader";
    scriptLoader('*[data-js=google-map]', 'scripts/partials/google-map');
</script>