---
import '@styles/partials/_google-map.scss';
const { geoLocation, markerHTML, zoom = 8 } = Astro.props;
---

<div class="google-map" data-js="google-map" data-google-zoom-factor={JSON.stringify(zoom)} data-google-map-geo-location={JSON.stringify(geoLocation)} data-google-marker-html={JSON.stringify(markerHTML)} style="display: none;"></div>

<script>
    const $googleMaps = document.querySelectorAll('*[data-js=google-map]');

    if($googleMaps.length > 0){
        import('@scripts/partials/google-map')
            .then((module) => {
                const { googleMap } = module;
                googleMap.init();
            })
            .catch((error) => {
                console.error('Error loading module:', error);
            });
    }
</script>