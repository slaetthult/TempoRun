---
const { geoLocation, markerHTML, zoom = 8 } = Astro.props;
---

<partial-google-map class="google-map" data-js="google-map" data-google-zoom-factor={JSON.stringify(zoom)} data-google-map-geo-location={JSON.stringify(geoLocation)} data-google-marker-html={JSON.stringify(markerHTML)} style="display: none;">

</partial-google-map>

<script>
    class PartialGoogleMap extends HTMLElement {
        constructor() {
            super();
        }
        connectedCallback() {
            import('@scripts/partials/google-map')
                .then((module) => {
                    const { googleMap } = module;
                    googleMap.init(this);
                })
                .catch((error) => {
                    console.error('Error loading module:', error);
                });

        }

    }
    customElements.define('partial-google-map', PartialGoogleMap);
</script>