<partial-cookie-consent class="cookie-consent" data-js="cookie-consent" style="display: none;">
    <div class="grid-wrap">
        <div class="cookie-consent__wrapper w12">
            Cookie

            <button data-cookie-consent-accept-all>Accept all cookies</button>
            <button data-cookie-consent-accept-technical>Accept technical cookies</button>

        </div>
    </div>
</partial-cookie-consent>

<script>
    class PartialCookieConsent extends HTMLElement {
        constructor() {
            super();
        }
        connectedCallback() {
            import('@scripts/partials/cookie-consent')
                .then((module) => {
                    const { cookieConsent } = module;
                    cookieConsent.init(this);
                })
                .catch((error) => {
                    console.error('Error loading module:', error);
                });

        }

    }
    customElements.define('partial-cookie-consent', PartialCookieConsent);
</script>