---
import '@styles/partials/_modalbox.scss';
const {
    id = '',
    classes = ''
} = Astro.props;
const className = `modalbox ${id} ${classes}`;
---

<div class={className} data-js="modalbox" style="display: none;">

    <div class="modalbox__wrapper">
        <div class="modalbox__header">
            <slot name="modalbox-header"/>
        </div>
        <slot/>
        <div class="modalbox__footer">
            <slot name="modalbox-footer"/>
        </div>
    </div>

</div>

<script>
    import {scriptLoader} from "@scripts/base/script-loader";
    scriptLoader('*[data-js=modalbox]', 'scripts/partials/modalbox');
</script>