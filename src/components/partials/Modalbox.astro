---
import '@styles/partials/_modalbox.scss';
const {id = '', classes = ''} = Astro.props;
const className = `modalbox ${id} ${classes}`;
---

<div class={className} data-js="modalbox" style="display: none;">

    <div class="modalbox__wrapper">
        <div class="modalbox__header">
            <slot name="modalbox-header"/>
        </div>
        <slot/>
        <div class="modalbox__footer">
            <slot name="modalbox-footer"/>
        </div>
    </div>

</div>

<script>
    const $modalboxes = document.querySelectorAll('*[data-js=modalbox]');

    if($modalboxes.length > 0){
        import('@scripts/partials/modalbox')
            .then((module) => {
                const { modalbox } = module;

                modalbox.init();
            })
            .catch((error) => {
                console.error('Error loading module:', error);
            });
    }
</script>