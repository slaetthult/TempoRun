---
import '@styles/partials/_to-top-button.scss';
---
<button data-js="to-top-button" class="to-top-button">
    <svg width="12" height="12" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg"><path d="m6 1 5 5-5 5m5-5H1" stroke="#fff" stroke-width="1.5" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>

<script>
    const $toTopButtons = document.querySelectorAll('*[data-js=to-top-button]');

    if($toTopButtons.length > 0){
        import('@scripts/partials/to-top-button')
            .then((module) => {
                const { toTopButton } = module;

                toTopButton.init();
            })
            .catch((error) => {
                console.error('Error loading module:', error);
            });
    }
</script>