<partial-to-top-button data-js="to-top-button">
    <button class="to-top-button">
        <svg width="12" height="12" viewBox="0 0 12 12" xmlns="http://www.w3.org/2000/svg"><path d="m6 1 5 5-5 5m5-5H1" stroke="#fff" stroke-width="1.5" fill="none" fill-rule="evenodd" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
</partial-to-top-button>

<script>
    class PartialToTopButton extends HTMLElement {
        constructor() {
            super();
        }
        connectedCallback() {
            import('@scripts/partials/to-top-button')
                .then((module) => {
                    const { toTopButton } = module;
                    toTopButton.init(this.querySelector('button'));
                })
                .catch((error) => {
                    console.error('Error loading module:', error);
                });
        }

    }
    customElements.define('partial-to-top-button', PartialToTopButton);
</script>