---
const { forceIntoParagraph = false, textMore = 'Weiterlesen', textLess = 'Weniger', scrollAfterCollapse = 'true', classes = '' } = Astro.props;
---
<div class=`expandable-text ${classes}` data-js="expandable-text" data-expandable-text-scroll-after-collapse={scrollAfterCollapse}>
    <div class="expandable-text__wrapper" data-expandable-text-wrapper>
        {forceIntoParagraph ?
            <p>
                <slot/>
            </p>
            :
            <slot/>
        }
    </div>
    <div class="expandable-text__actions">
        <button data-expandable-text-toggle>
            <span>{textMore}</span>
            <span>{textLess}</span>
        </button>
    </div>
</div>

<script>
    const $expandableTexts = document.querySelectorAll('*[data-js=expandable-text]');

    if($expandableTexts.length > 0){
        import('@scripts/partials/expandable-text')
            .then((module) => {
                const { expandableText } = module;
                expandableText.init();
            })
            .catch((error) => {
                console.error('Error loading module:', error);
            });
    }
</script>